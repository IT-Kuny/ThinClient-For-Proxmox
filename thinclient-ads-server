#!/usr/bin/env python3
"""
thinclient-ads-server — localhost HTTP server for the kiosk ads page

Serves /var/lib/thinclient/ads on 127.0.0.1:8765 so the chromium kiosk
can render the page over HTTP instead of file:// — which enables the
"VM auswählen" button on the page.

POST /open-picker  ->  spawns `thinclient-gui --picker` on the local X
session (DISPLAY/XAUTHORITY inherited from the session that started us).

Started by thinclient-session. Binds loopback only — no remote access.
"""

import html
import http.server
import logging
import os
import subprocess
import socketserver
import time

PORT = 8765
ADS_DIR = "/var/lib/thinclient/ads"
GUI = "/usr/local/bin/thinclient-gui"
LOG_DIR = os.path.expanduser("~/.config/thinclient")
DEBOUNCE_SEC = 5

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s %(message)s",
    handlers=[logging.StreamHandler()],
)

_last_spawn = 0.0


def spawn_picker():
    global _last_spawn
    now = time.monotonic()
    if now - _last_spawn < DEBOUNCE_SEC:
        logging.info("open-picker: debounce, ignoring")
        return False
    _last_spawn = now
    env = dict(os.environ)
    env.setdefault("DISPLAY", ":0")
    env.setdefault("XAUTHORITY", os.path.expanduser("~/.Xauthority"))
    os.makedirs(LOG_DIR, exist_ok=True)
    logf = open(os.path.join(LOG_DIR, "picker.log"), "a")
    subprocess.Popen(
        [GUI, "--picker"],
        env=env,
        stdout=logf,
        stderr=subprocess.STDOUT,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    logging.info("open-picker: spawned %s --picker", GUI)
    return True


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "thinclient-ads/1.0"

    def _no_store(self):
        self.send_header("Cache-Control", "no-store, must-revalidate")

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path == "/":
            path = "/index.html"
        # sanitize: no traversal outside ADS_DIR
        fname = os.path.normpath(path).lstrip("/")
        fpath = os.path.realpath(os.path.join(ADS_DIR, fname))
        if not fpath.startswith(os.path.realpath(ADS_DIR) + os.sep) or not os.path.isfile(fpath):
            self.send_error(404)
            return
        ctype = "text/html; charset=utf-8" if fpath.endswith(".html") else "application/octet-stream"
        with open(fpath, "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self._no_store()
        self.end_headers()
        self.wfile.write(data)

    def do_POST(self):
        if self.path.split("?", 1)[0] != "/open-picker":
            self.send_error(404)
            return
        length = int(self.headers.get("Content-Length") or 0)
        if length:
            self.rfile.read(min(length, 65536))
        ok = spawn_picker()
        body = b'{"ok":true}' if ok else b'{"ok":false}'
        self.send_response(200 if ok else 429)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self._no_store()
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        logging.info("%s %s", self.address_string(), fmt % args)


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True


if __name__ == "__main__":
    os.makedirs(ADS_DIR, exist_ok=True)
    logging.info("serving %s on 127.0.0.1:%d", ADS_DIR, PORT)
    Server(("127.0.0.1", PORT), Handler).serve_forever()
