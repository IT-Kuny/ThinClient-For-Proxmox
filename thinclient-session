#!/bin/bash
# thinclient-session — X session wrapper for GDM/LightDM/SDDM
# Launched by the display manager as the full X session

export DISPLAY="${DISPLAY:-:0}"
LOGFILE="$HOME/.config/thinclient/session.log"
mkdir -p "$HOME/.config/thinclient"

exec > "$LOGFILE" 2>&1
echo "[$(date)] thinclient-session started, DISPLAY=$DISPLAY"

# Wait for X to be ready
for i in $(seq 1 10); do
    xdpyinfo &>/dev/null && break
    sleep 0.5
done

if ! xdpyinfo &>/dev/null; then
    echo "[$(date)] ERROR: X display not available, aborting"
    exit 1
fi

# Basic X setup
xsetroot -solid "#1a1a2e" 2>/dev/null || true
unclutter -idle 5 -root &>/dev/null &

echo "[$(date)] Launching thinclient-gui"
/usr/local/bin/thinclient-gui 2>&1
EXIT_CODE=$?

echo "[$(date)] thinclient-gui exited with code $EXIT_CODE"
exit $EXIT_CODE
