#!/bin/bash
# thinclient-session — X session wrapper for GDM/LightDM/SDDM
# Launched by the display manager as the full X session

export DISPLAY="${DISPLAY:-:0}"

# Ensure XAUTHORITY is set for GDM sessions
if [[ -z "$XAUTHORITY" ]]; then
    export XAUTHORITY="$HOME/.Xauthority"
fi

LOGFILE="$HOME/.config/thinclient/session.log"
mkdir -p "$HOME/.config/thinclient"

exec > "$LOGFILE" 2>&1
echo "[$(date)] thinclient-session started, DISPLAY=$DISPLAY, XAUTHORITY=$XAUTHORITY"

# Wait for X to be ready
for i in $(seq 1 10); do
    xdpyinfo &>/dev/null && break
    sleep 0.5
done

if ! xdpyinfo &>/dev/null; then
    echo "[$(date)] ERROR: X display not available, aborting"
    exit 1
fi

# Basic X setup
xsetroot -solid "#1a1a2e" 2>/dev/null || true
unclutter -idle 5 -root &>/dev/null &

# Start minimal WM so zenity/xterm dialogs are centered properly
if command -v openbox &>/dev/null; then
    mkdir -p "$HOME/.config/openbox"
    cp /usr/local/share/thinclient/openbox-rc.xml "$HOME/.config/openbox/rc.xml" 2>/dev/null || true
    openbox --config-file "$HOME/.config/openbox/rc.xml" &
    WM_PID=$!
    echo "[$(date)] openbox started (PID $WM_PID)"
    sleep 1
elif command -v metacity &>/dev/null; then
    metacity --replace &
    WM_PID=$!
    echo "[$(date)] metacity started (PID $WM_PID)"
    sleep 1
fi

echo "[$(date)] Launching thinclient-gui"
/usr/local/bin/thinclient-gui 2>&1
EXIT_CODE=$?

echo "[$(date)] thinclient-gui exited with code $EXIT_CODE"
exit $EXIT_CODE
