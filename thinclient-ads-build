def build_html(projects, rotate_sec, org="IT-Kuny"):
    if not projects:
        body = '<div class="fallback">No project READMEs found.<br>Configure /etc/thinclient/ads.conf</div>'
        dots = ""
    else:
        slides = []
        for p in projects:
            meta = p.get("_meta", {})
            meta_html = ""
            if meta.get("language"):
                meta_html += f'<span>💻 {html.escape(meta["language"])}</span>'
            if meta.get("stars", 0) > 0:
                meta_html += f'<span>⭐ {meta["stars"]}</span>'

            # Prefer GitHub metadata description if slide tagline is empty
            tagline = p.get('tagline') or meta.get('description') or ''
            if not tagline and meta.get('description'):
                tagline = meta['description']

            slide = f"""<section class="slide">
    <header class="slide-header">
        <h1 class="slide-title">{html.escape(p['title'])}</h1>
        {f'<div class="slide-meta">{meta_html}</div>' if meta_html else ''}
    </header>
    {f'<div class="slide-url">{html.escape(p["url"])}</div>' if p['url'] else ''}
    {f'<p class="slide-tagline">{html.escape(tagline[:200])}</p>' if tagline else ''}
    {p['body']}
</section>"""
            slides.append(slide)
        dots = '<div class="carousel-nav">' + "".join(
            f'<div class="dot"></div>' for _ in projects
        ) + '</div>'
        body = "\n".join(slides)

    org_badge = f'<div class="org-badge">github.com/<a href="https://github.com/{org}">{org}</a></div>'

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{org} — ThinClient Kiosk</title>
<style>{CSS}</style>
</head>
<body>
<div class="carousel">
{body}
</div>
{dots}
{org_badge}
<button class="picker-btn" id="picker-btn" type="button">🖥  VM auswählen</button>
<script>{JS_TEMPLATE.format(rotate_ms=rotate_sec * 1000)}</script>
</body>
</html>
"""


def main():
    ap = argparse.ArgumentParser(description="Build ThinClient ad page from GitHub org READMEs")
    ap.add_argument("-c", "--config", default=DEFAULT_CONFIG)
    ap.add_argument("-o", "--output", default=DEFAULT_OUTPUT)
    ap.add_argument("--org", help="GitHub organization (overrides config)")
    ap.add_argument("--local-only", action="store_true",
                    help="Skip GitHub fetch, use only local repos from config")
    args = ap.parse_args()

    cfg = load_config(args.config)
    org = args.org or cfg["org"]
    rotate = cfg["rotate"]
    token = cfg["token"] or os.environ.get("GITHUB_TOKEN", "")
    local_repos = cfg["repos"]

    projects = []

    # Remote: fetch all repos from GitHub org
    if not args.local_only and org:
        print(f"fetching public repos for org '{org}'...")
        repos = fetch_org_repos(org, token,
                                include_forked=cfg["include_forked"],
                                include_archived=cfg["include_archived"])
        print(f"  {len(repos)} public repos (excluding forks/archived as configured)")
        for r in repos:
            slide = parse_repo_remote(org, r["name"], r["default_branch"], token)
            if slide:
                # Use GitHub description if slide tagline is empty
                if r["description"] and not slide.get("tagline"):
                    slide["tagline"] = clean_text(r["description"], 200)
                slide["_meta"] = {
                    "stars": r["stars"],
                    "language": r["language"],
                    "topics": r["topics"],
                    "description": r["description"],
                }
                projects.append(slide)
                print(f"  ✓ {r['name']:<35}  (tagline={len(slide.get('tagline', ''))}c, highlights={len(slide.get('highlights', []))})")
            else:
                print(f"  – {r['name']:<35}  (no README)", file=sys.stderr)

    # Local: also include explicitly configured repos (dedup vs remote by repo name)
    seen = {p["url"].rstrip("/").rsplit("/", 1)[-1].removesuffix(".git") for p in projects}
    for repo in local_repos:
        repo = os.path.expanduser(repo)
        for name in ("README.md", "README.md", "readme.md"):
            readme = os.path.join(repo, name)
            if os.path.isfile(readme):
                base = Path(repo).name
                if base in seen:
                    print(f"  – local: {repo}  (already in deck, skipped)")
                    break
                p = parse_repo_local(readme, repo)
                if p:
                    seen.add(base)
                    projects.append(p)
                    print(f"  ✓ local: {repo}/{name}  ({len(p['body'])} bytes)")
                break

    if not projects:
        print("WARNING: no READMEs found — generating fallback page", file=sys.stderr)

    html_doc = build_html(projects, rotate, org=org)

    out_dir = os.path.dirname(args.output)
    os.makedirs(out_dir, exist_ok=True)
    tmp = args.output + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(html_doc)
    os.replace(tmp, args.output)
    print(f"OK: wrote {args.output} ({len(html_doc)} bytes, {len(projects)} project(s))")


if __name__ == "__main__":
    main()
