#!/usr/bin/env python3
"""
thinclient-ads-build — Generate kiosk HTML ad page from GitHub org READMEs

Fetches all public repositories from a GitHub organization (default:
IT-Kuny) and renders each project's README.md as a slide in a
self-contained rotating kiosk page.

Output: /var/lib/thinclient/ads/index.html

Config: /etc/thinclient/ads.conf
    org=IT-Kuny
    rotate_interval=10
    github_token=ghp_...        # optional, raises rate limit
    repos=/path1:/path2         # optional, adds local repos to the deck
    include_forked=false       # default: skip forks
    include_archived=false     # default: skip archived

Usage:
    sudo thinclient-ads-build                 # build once
    sudo thinclient-ads-build --org IT-Kuny   # override org
    sudo thinclient-ads-build --local-only    # ignore GitHub, use repos= only
"""

import argparse
import html
import json
import os
import re
import sys
import urllib.request
from pathlib import Path


DEFAULT_CONFIG = "/etc/thinclient/ads.conf"
DEFAULT_OUTPUT = "/var/lib/thinclient/ads/index.html"
DEFAULT_ORG = "IT-Kuny"
DEFAULT_ROTATE_SEC = 10
GITHUB_API = "https://api.github.com"
GITHUB_RAW = "https://raw.githubusercontent.com"


ALERT_RE = re.compile(r"^\s*\[!(NOTE|TIP|CAUTION|WARNING|IMPORTANT|TODO)\]", re.IGNORECASE)
HTML_TAG_RE = re.compile(r"<[^>]+>")


def clean_text(text, limit):
    """Unescape entities, strip HTML tags + markdown alerts, cut at word boundary."""
    text = html.unescape(text)
    text = ALERT_RE.sub("", text)
    text = HTML_TAG_RE.sub(" ", text)
    text = re.sub(r"`*_>#", " ", text)
    text = re.sub(r"\[([^]]+)\]\([^)]+\)", r"\1", text)   # md links -> text
    text = re.sub(r"\s+", " ", text).strip()
    if len(text) > limit:
        cut = text[:limit].rsplit(" ", 1)[0]
        text = (cut + "…") if len(text) > limit else text
    return text


def load_config(path):
    cfg = {
        "org": DEFAULT_ORG,
        "rotate": DEFAULT_ROTATE_SEC,
        "token": "",
        "repos": [],
        "include_forked": False,
        "include_archived": False,
    }
    if not os.path.isfile(path):
        return cfg
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("org="):
                cfg["org"] = line.split("=", 1)[1].strip()
            elif line.startswith("rotate_interval="):
                try:
                    cfg["rotate"] = int(line.split("=", 1)[1])
                except ValueError:
                    pass
            elif line.startswith("github_token="):
                cfg["token"] = line.split("=", 1)[1].strip()
            elif line.startswith("repos="):
                cfg["repos"] = [p for p in line.split("=", 1)[1].split(":") if p]
            elif line.startswith("include_forked="):
                cfg["include_forked"] = line.split("=", 1)[1].strip().lower() in ("1", "true", "yes")
            elif line.startswith("include_archived="):
                cfg["include_archived"] = line.split("=", 1)[1].strip().lower() in ("1", "true", "yes")
    return cfg


def github_api_get(path, token=""):
    url = f"{GITHUB_API}{path}"
    req = urllib.request.Request(url)
    req.add_header("Accept", "application/vnd.github+json")
    req.add_header("User-Agent", "thinclient-ads-build")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read().decode("utf-8")), dict(resp.headers)
    except Exception as e:
        print(f"  github API error: {e}", file=sys.stderr)
        return None, {}


def fetch_org_repos(org, token="", include_forked=False, include_archived=False):
    """Return list of repo metadata dicts."""
    repos = []
    page = 1
    while True:
        q = f"/orgs/{org}/repos?per_page=100&page={page}&type=public"
        data, headers = github_api_get(q, token)
        if data is None:
            break
        if not data:
            break
        for r in data:
            if r.get("fork") and not include_forked:
                continue
            if r.get("archived") and not include_archived:
                continue
            repos.append({
                "name": r.get("name", "?"),
                "description": r.get("description") or "",
                "html_url": r.get("html_url", ""),
                "default_branch": r.get("default_branch", "main"),
                "topics": r.get("topics", []),
                "language": r.get("language") or "",
                "stars": r.get("stargazers_count", 0),
            })
        remaining = headers.get("X-RateLimit-Remaining")
        if remaining == "0":
            print(f"  GitHub rate limit hit after {len(repos)} repos", file=sys.stderr)
            break
        if len(data) < 100:
            break
        page += 1
    return repos


def fetch_readme_raw(org, repo, branch, token=""):
    """Fetch README via raw.githubusercontent.com (no API rate limit cost)."""
    candidates = ["README.md", "README.md", "readme.md", "README.rst", "README"]
    for fname in candidates:
        url = f"{GITHUB_RAW}/{org}/{repo}/{branch}/{fname}"
        req = urllib.request.Request(url)
        req.add_header("User-Agent", "thinclient-ads-build")
        if token:
            req.add_header("Authorization", f"Bearer {token}")
        try:
            with urllib.request.urlopen(req, timeout=15) as resp:
                return resp.read().decode("utf-8", errors="replace"), fname
        except Exception:
            continue
    return None, None


def md_to_slide(md_text, fallback_title, source_url, repo_meta=None):
    """Extract a short, slide-friendly summary from a README.

    Returns only:
      - title (first H1)
      - tagline (first paragraph, ≤200 chars)
      - highlights (up to 5 bullet points from the first ##/top-level list)
      - topics (passed through from repo metadata)
    No full-body HTML, no code blocks, no long lists.
    """
    # Title = repo name (README H1s are often section headings like
    # "Install (as root)" — not a useful slide title)
    title = fallback_title

    # Tagline: first non-empty paragraph that isn't a heading or badge
    tagline = ""
    lines = md_text.splitlines()
    paragraph = []
    for line in lines[1:]:  # skip the H1
        stripped = line.strip()
        if not stripped:
            if paragraph:
                break
            continue
        if stripped.startswith("#"):
            if paragraph:
                break
            continue
        if not paragraph and (stripped.startswith(("!", "[", "<", "|")) or ALERT_RE.match(stripped)):
            # Skip badge/HTML-table/alert lines at the top
            continue
        if ALERT_RE.match(stripped):
            continue
        paragraph.append(stripped)
    if paragraph:
        tagline = clean_text(" ".join(paragraph), 200)

    # Highlights: collect up to 5 short bullets from first ## section
    # or top-level bullet list (skip code blocks entirely).
    highlights = []
    in_code = False
    seen_section = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            continue
        # First ## — start collecting bullets only from this point
        if stripped.startswith("## "):
            section = stripped[3:].strip()
            # Collect bullets only from sections worth showing
            seen_section = section.lower() not in (
                "installation", "install", "requirements",
                "license", "licensing", "contributing", "changelog",
                "credits", "acknowledgments", "acknowledgements",
                "usage", "examples", "example",
                "configuration", "options",
                "building", "build", "compilation",
                "testing", "test", "tests",
                "documentation", "docs",
                "support", "contact", "author",
                "disclaimer", "legal",
                "table of contents", "toc",
                "description", "overview",
                "introduction", "intro")
            continue
        elif (stripped.startswith("- ") or stripped.startswith("* ")) and seen_section:
            if len(highlights) < 5:
                bullet = stripped[2:].strip()
                # Strip markdown links/formatting
                bullet = clean_text(bullet, 120)
                if bullet and not bullet.lower().startswith(("http", "www.", "npm ", "pip ", "apt ", "dnf ", "yarn ")):
                    # Skip headers-like bullets (single word, title-case, ends with :)
                    if not (len(bullet) < 40 and bullet.endswith(":")):
                        highlights.append(bullet)

    body_html = ""
    if highlights:
        items = "\n".join(f"<li>{html.escape(h)}</li>" for h in highlights)
        body_html += f"<ul class=\"slide-highlights\">{items}</ul>"

    return {
        "title": title,
        "description": "",  # populated from GitHub API metadata if available
        "tagline": tagline,
        "highlights": highlights,
        "body": body_html,
        "url": source_url,
        "_meta": repo_meta or {},
    }


def parse_repo_local(readme_path, repo_dir):
    if not os.path.isfile(readme_path):
        return None
    with open(readme_path, "r", encoding="utf-8", errors="replace") as f:
        md_text = f.read()

    url = ""
    git_cfg = os.path.join(repo_dir, ".git", "config")
    if os.path.isfile(git_cfg):
        with open(git_cfg, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                m = re.match(r"^\s*url\s*=\s*(.+)$", line)
                if m:
                    url = m.group(1).strip()
                    break

    return md_to_slide(md_text, Path(repo_dir).name, url)


def parse_repo_remote(org, repo_name, branch, token=""):
    md_text, _ = fetch_readme_raw(org, repo_name, branch, token)
    if not md_text:
        return None
    url = f"https://github.com/{org}/{repo_name}"
    return md_to_slide(md_text, repo_name, url)


